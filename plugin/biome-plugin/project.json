{
  "name": "biome-plugin",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "plugin/biome-plugin/src",
  "projectType": "library",
  "tags": ["plugin"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/plugin/biome-plugin",
        "main": "plugin/biome-plugin/src/index.ts",
        "tsConfig": "plugin/biome-plugin/tsconfig.lib.json",
        "assets": [
          "plugin/biome-plugin/*.md",
          {
            "input": "./plugin/biome-plugin/src",
            "glob": "**/!(*.ts)",
            "output": "./src"
          },
          {
            "input": "./plugin/biome-plugin/src",
            "glob": "**/*.d.ts",
            "output": "./src"
          },
          {
            "input": "./plugin/biome-plugin",
            "glob": "generators.json",
            "output": "."
          },
          {
            "input": "./plugin/biome-plugin",
            "glob": "executors.json",
            "output": "."
          }
        ]
      }
    },
    "typecheck": {
      "cache": true,
      "inputs": ["production", "^production", { "externalDependencies": ["typescript"] }],
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p tsconfig.lib.json",
        "cwd": "{projectRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "mkdir -p ../../junit_reports/unit && bun test $(find . -type f -name '*.spec.ts') --pass-with-no-tests --reporter=junit --reporter-outfile=../../junit_reports/unit/biome-plugin.xml",
        "cwd": "{projectRoot}",
        "forwardAllArgs": true
      }
    }
  }
}
