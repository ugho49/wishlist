{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "types": ["node", "bun"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "verbatimModuleSyntax": true
  },
  "exclude": ["src/**/*.int-spec.ts", "src/**/*.spec.ts"],
  "include": ["src/**/*.ts", "codegen.ts"]
}
