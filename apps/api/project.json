{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/api/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "codegen": {
      "executor": "nx:run-commands",
      "options": {
        "command": "graphql-codegen --config codegen.ts",
        "cwd": "{projectRoot}",
        "forwardAllArgs": true
      }
    },
    "serve": {
      "continuous": true,
      "executor": "nx:run-commands",
      "options": {
        "command": "bun --watch run src/main.ts",
        "cwd": "{projectRoot}"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["nx run api:codegen --watch", "nx run api:serve"]
      }
    },
    "typecheck": {
      "cache": true,
      "inputs": ["production", "^production", { "externalDependencies": ["typescript"] }],
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p tsconfig.app.json",
        "cwd": "{projectRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun test $(find . -type f -name '*.spec.ts' ! -name '*.int-spec.ts') --preload ./test-utils/matchers.ts --reporter=junit --reporter-outfile=../../junit_reports/unit/api.xml",
        "cwd": "{projectRoot}",
        "forwardAllArgs": true
      }
    },
    "test:int": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun test $(find . -type f -name '*.int-spec.ts') --preload ./test-utils/global-setup.ts --preload ./test-utils/matchers.ts --timeout 30000 --max-concurrency 1 --reporter=junit --reporter-outfile=../../junit_reports/integration/api.xml",
        "cwd": "{projectRoot}",
        "forwardAllArgs": true
      }
    }
  }
}
