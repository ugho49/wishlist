## Global Environment
PORT=8080
NODE_ENV=development
FRONTEND_BASE_URL=http://localhost:4200
API_VERSION=0.0.0

## Database
DB_HOST="localhost"
DB_PORT=5433
DB_USERNAME="service"
DB_PASSWORD="service"
DB_NAME="wishlist-api"
DB_VERBOSE=false

## Valkey (Queue)
VALKEY_HOST="localhost"
VALKEY_PORT=6381
VALKEY_PASSWORD=""
VALKEY_DB=0
SCHEDULED_JOBS_ENABLED=true

## Auth
AUTH_ISSUER="Wishlist API"

AUTH_ACCESS_TOKEN_SECRET="auth-access-token-secret" # openssl rand -hex 32
AUTH_ACCESS_TOKEN_DURATION="15m"
AUTH_ACCESS_TOKEN_ALGORITHM="HS512"
AUTH_REFRESH_TOKEN_DURATION="30d"

## Google Oauth
GOOGLE_OAUTH_CLIENT_ID="TBD"
GOOGLE_OAUTH_CLIENT_SECRET="TBD"

## Reset password
RESET_PASSWORD_TOKEN_DURATION_IN_MIN=15

## Change email
EMAIL_CHANGE_VERIFICATION_TOKEN_DURATION_IN_MIN=15

## Mails
MAIL_PROVIDER=maildev
MAILDEV_HOST=localhost
MAILDEV_PORT=1025

# Production:
# MAIL_PROVIDER=resend
# RESEND_API_KEY=

# Firebase
FIREBASE_BUCKET_NAME="TBD"
FIREBASE_BUCKET_MOCK=false
