{
  "name": "@wishlist/source",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "libs/*", "plugin/*"],
  "scripts": {
    "postinstall": "husky",
    "serve:all": "nx run-many --target=serve",
    "serve:front": "nx serve front",
    "serve:front:with-codegen": "nx run front:serve:watch-codegen",
    "serve:api": "nx serve api",
    "serve:api:with-codegen": "nx run api:serve:watch-codegen",
    "build": "nx run-many --target=build",
    "test:unit": "nx run-many --target=test --exclude=@wishlist/source",
    "test:int": "nx run-many --target=test:int",
    "check": "biome check --diagnostic-level=error --reporter=summary",
    "check:fix": "bun check --write",
    "docker:up": "docker compose -f ./docker/docker-compose.yml -f ./docker/docker-compose.local.yml up -d",
    "docker:down": "docker compose -f ./docker/docker-compose.yml -f ./docker/docker-compose.local.yml down --remove-orphans",
    "typecheck": "nx run-many --target=typecheck --exclude=@wishlist/source",
    "bump-deps": "npx npm-check-updates -u -i --format group",
    "db:migrate": "nx run api:drizzle:migrate",
    "db:seed": "nx run api:drizzle:seed",
    "mail:preview": "nx run mail:preview"
  },
